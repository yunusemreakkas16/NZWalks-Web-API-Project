@model NZWalks.UI.Models.AddRegionViewModel
@{
}

<h1class="mt-3">AddRegion</h1>

	<form method="post">

		<div class="mt-3">
			<label class="form-label">Code</label>
			<input type="text" class="form-control" asp-for="Code"/>
		</div>

		<div class="mt-3">
			<label class="form-label">Name</label>
			<input type="text" class="form-control" asp-for="Name"/>
		</div>

		<div class="mt-3">
			<label class="form-label">ImageUrl</label>
			<input type="text" class="form-control" asp-for="RegionImageUrl"/>
		</div>

		<div class="mt-3">
			<button type="submit" class="btn btn-primary">Save</button>

	</form>
		